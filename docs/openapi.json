              }
            }
          }
        }
      }
    },
    "/api/units/{plant}/products/{product}/drafts/{id}": {
      "put": {
        "summary": "Atualizar revisão do rascunho",
        "parameters": [
          {
            "name": "plant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "product",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
