                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Credencial inválida"
          },
          "403": {
            "description": "Sem acesso efetivo"
          },
          "404": {
            "description": "Registro ausente"
          },
          "409": {
            "description": "Conflito de código ou revisão"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "integer"
                  },
                  "sheet": {
                    "$ref": "#/components/schemas/Sheet"
                  }
                },
                "required": [
                  "revision",
                  "sheet"
                ]
              }
            }
          }
        }
      }
    },
    "/api/units/{plant}/products/{product}/drafts/{id}/publication": {
      "post": {
        "summary": "Publicar revisão de forma idempotente",
        "parameters": [
          {
            "name": "plant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "product",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Credencial inválida"
          },
          "403": {
            "description": "Sem acesso efetivo"
          },
          "404": {
            "description": "Registro ausente"
          },
          "409": {
            "description": "Conflito de código ou revisão"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "integer"
                  }
                },
                "required": [
                  "revision"
                ]
              }
            }
          }
        }
      }
    },
    "/api/units/{plant}/products/{product}/versions": {
      "get": {
        "summary": "Listar versões do produto",
        "parameters": [
          {
            "name": "plant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "product",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Credencial inválida"
          },
          "403": {
            "description": "Sem acesso efetivo"
          },
          "404": {
            "description": "Registro ausente"
          },
          "409": {
            "description": "Conflito de código ou revisão"
          }
        }
      }
    },
    "/api/units/{plant}/products/{product}/versions/{version}": {
      "get": {
        "summary": "Consultar composição e roteiro históricos",
        "parameters": [
          {
            "name": "plant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "product",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Publication"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Credencial inválida"
          },
          "403": {
            "description": "Sem acesso efetivo"
          },
          "404": {
            "description": "Registro ausente"
          },
          "409": {
            "description": "Conflito de código ou revisão"
          }
        }
      }
    },
    "/api/me/context": {
      "get": {
        "summary": "Contexto autorizado da pessoa autenticada",
        "responses": {
          "200": {
            "description": "Grupo, unidades, ações e setores liberados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accountId",
                    "units"
                  ],
                  "properties": {
                    "accountId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "units": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "groupName",
                          "actions",
                          "sectors"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "groupName": {
                            "type": "string"
                          },
                          "actions": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "sectors": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "id",
                                "name"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Conta sem acesso"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ItemInput": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "unitId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "Kind": {
        "type": "string",
        "enum": [
          "category",
          "unit",
          "material",
          "product",
          "part"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "value": {
            "$ref": "#/components/schemas/ItemInput"
          }
        },
        "required": [
          "id",
          "kind",
          "value"
        ]
      },
      "PieceLine": {
        "type": "object",
        "properties": {
          "partId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Ordem de execução por peça"
          },
          "thicknessMm": {
            "type": "number",
            "nullable": true
          },
          "piecesPerPlate": {
            "type": "integer",
            "nullable": true
          },
          "piecesPerCut": {
            "type": "integer",
            "nullable": true
          },
          "minutesPerCut": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "partId",
          "quantity",
          "steps"
        ]
      },
      "MaterialLine": {
        "type": "object",
        "properties": {
          "materialId": {
            "type": "string",
            "format": "uuid"
          },
          "unitId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          }
        },
        "required": [
          "materialId",
          "unitId",
          "quantity"
        ]
      },
      "Sheet": {
        "type": "object",
        "properties": {
          "pieces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PieceLine"
            },
            "minItems": 1
          },
          "materials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MaterialLine"
            }
          }
        },
        "required": [
          "pieces",
          "materials"
        ]
      },
      "Draft": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer"
          },
          "sheet": {
            "$ref": "#/components/schemas/Sheet"
          }
        },
        "required": [
          "id",
          "revision",
          "sheet"
        ]
      },
      "Publication": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer"
          },
          "actor": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "product": {
            "$ref": "#/components/schemas/Item"
          },
          "sheet": {
            "$ref": "#/components/schemas/Sheet"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "material": {
                  "$ref": "#/components/schemas/Item"
                },
                "category": {
                  "$ref": "#/components/schemas/Item"
                },
                "unit": {
                  "$ref": "#/components/schemas/Item"
                }
              },
              "required": [
                "material",
                "category",
                "unit"
              ]
            }
          }
        },
        "required": [
          "version",
          "actor",
          "publishedAt",
          "product",
          "sheet",
          "parts",
          "materials"
        ]
      }
    }
  }
}
