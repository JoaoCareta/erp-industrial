{
  "openapi": "3.0.3",
  "info": {
    "title": "ERP Industrial",
    "version": "0.1.0"
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/api/ready": {
      "get": {
        "summary": "Consultar migrações aplicadas",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "migrations": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "migrations"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Credencial inválida"
          },
          "403": {
            "description": "Sem acesso efetivo"
          },
          "404": {
            "description": "Registro ausente"
          },
          "409": {
            "description": "Conflito de código ou revisão"
          }
        },
        "security": []
      }
    },
    "/api/units/{plant}/sectors/{sector}/team": {
      "get": {
        "summary": "Consultar equipe ativa de um setor",
        "parameters": [
          {
            "name": "plant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "sector",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "name": {
                        "type": "string"
                      },
                      "role": {
                        "type": "string",
                        "nullable": true,
                        "description": "Funções atribuídas neste setor."
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "role"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Credencial inválida"
          },
          "403": {
            "description": "Sem acesso efetivo"
          },
          "404": {
            "description": "Registro ausente"
          },
          "409": {
            "description": "Conflito de código ou revisão"
          }
        }
      }
    },
    "/api/units/{plant}/catalog/{kind}": {
      "get": {
        "summary": "Listar cadastros por tipo",
        "parameters": [
          {
            "name": "plant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Credencial inválida"
          },
          "403": {
            "description": "Sem acesso efetivo"
          },
          "404": {
            "description": "Registro ausente"
          },
          "409": {
            "description": "Conflito de código ou revisão"
          }
        }
      },
      "post": {
        "summary": "Criar cadastro",
        "parameters": [
          {
            "name": "plant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Credencial inválida"
          },
          "403": {
            "description": "Sem acesso efetivo"
          },
          "404": {
            "description": "Registro ausente"
          },
          "409": {
            "description": "Conflito de código ou revisão"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              }
            }
          }
        }
      }
    },
    "/api/units/{plant}/catalog/{kind}/{id}": {
      "put": {
        "summary": "Atualizar cadastro",
        "parameters": [
          {
            "name": "plant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Kind"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Credencial inválida"
          },
          "403": {
            "description": "Sem acesso efetivo"
          },
          "404": {
            "description": "Registro ausente"
          },
          "409": {
            "description": "Conflito de código ou revisão"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              }
            }
          }
        }
      }
    },
    "/api/units/{plant}/products/{product}/drafts": {
      "post": {
        "summary": "Criar rascunho",
        "parameters": [
          {
            "name": "plant",
            "in": "path",
